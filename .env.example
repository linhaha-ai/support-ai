# 此文件只是变量说明，不含可用凭据。不要提交填入真实值的 .env。
# Compose: docker compose --env-file .env -f deploy/compose.dev.yml up -d postgres
# 原生 Maven / Java 不会自动读取此文件，须在启动终端设置对应 $env:变量。

POSTGRES_DB=supportai
POSTGRES_USER=supportai
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# DB_PASSWORD 必须与 POSTGRES_PASSWORD 一致。
DB_URL=jdbc:postgresql://localhost:5432/supportai
DB_USERNAME=supportai
DB_PASSWORD=

# 默认 ollama profile 不需要 DashScope 密钥。
# 混合模式启用 dashscope profile 后，分别覆盖以下两个变量。
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=bge-m3
AI_CONNECT_TIMEOUT=10s
AI_READ_TIMEOUT=180s

# 只有选用 DashScope 时才需要；云端默认地域为北京。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
