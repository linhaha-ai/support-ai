# 复制为 deploy/.env 后填写强密码；示例文件不保存真实口令。
SUPPORT_AI_DB_PASSWORD=

# 默认仅允许本机访问；需要对外提供服务时再显式调整监听地址。
SUPPORT_AI_BIND_ADDRESS=127.0.0.1
SUPPORT_AI_HTTP_PORT=8088

# 仅在入口已启用 HTTPS 时设为 true，否则浏览器不会回传会话 Cookie。
SUPPORT_AI_COOKIE_SECURE=false

# 容器通过宿主机访问本地 Ollama，可按部署环境替换为独立模型服务地址。
SUPPORT_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
SUPPORT_AI_CHAT_MODEL=qwen2.5:3b
SUPPORT_AI_EMBEDDING_MODEL=bge-m3
