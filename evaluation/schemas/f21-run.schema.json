{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-ai.local/schemas/f21-run.schema.json",
  "title": "SupportAI F21 evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "results"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactKind": { "const": "F32_REAL_HTTP_EVALUATION" },
    "status": { "enum": ["COMPLETE_CAPTURE_PENDING_HUMAN_REVIEW", "PARTIAL_CAPTURE_PENDING_HUMAN_REVIEW"] },
    "capturedCases": { "type": "integer", "minimum": 0 },
    "expectedCases": { "type": "integer", "minimum": 1 },
    "sourceRunSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetVersion",
        "split",
        "datasetSha256",
        "gitCommit",
        "startedAt",
        "completedAt",
        "environment",
        "configSnapshot",
        "reviewer"
      ],
      "properties": {
        "datasetVersion": { "type": "string", "minLength": 1 },
        "split": { "enum": ["development", "test"] },
        "datasetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "environment": { "type": "string", "minLength": 1 },
        "configSnapshot": { "$ref": "#/$defs/configSnapshot" },
        "reviewer": { "type": "string", "minLength": 1 },
        "runtimeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtimeWithoutStrategyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bindingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceTreeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runnerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "freezeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "imageId": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "sourceDirtyPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "status",
          "answer",
          "noEvidence",
          "retrievedEvidenceIds",
          "citedEvidenceIds",
          "usage",
          "metrics",
          "humanReview"
        ],
        "properties": {
          "caseId": { "type": "string", "pattern": "^(DEV|TEST)-[0-9]{3}$" },
          "status": { "enum": ["COMPLETED", "DENIED", "FAILED", "CANCELLED", "CONTRACT_PASSED", "CONTRACT_FAILED"] },
          "answer": { "type": ["string", "null"] },
          "noEvidence": { "type": ["boolean", "null"] },
          "retrievedEvidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "citedEvidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "configSnapshot": { "$ref": "#/$defs/configSnapshot" },
          "requestId": { "type": "string", "format": "uuid" },
          "runId": { "type": "string", "format": "uuid" },
          "sessionId": { "type": "string", "format": "uuid" },
          "retrievalEvidenceBasis": { "const": "PERSISTED_MODEL_INPUT_SOURCES_AFTER_SCORE_AND_TOKEN_FILTERS" },
          "sources": { "type": "array", "items": { "$ref": "#/$defs/persistedSource" } },
          "citedSourcePreviews": { "type": "array", "items": { "type": "object" } },
          "errorCode": { "type": ["string", "null"] },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "finishedAt": { "type": ["string", "null"], "format": "date-time" },
          "streaming": { "type": ["object", "null"] },
          "usage": {
            "anyOf": [
              { "$ref": "#/$defs/chatUsage" },
              { "type": "null" }
            ]
          },
          "metrics": {
            "anyOf": [
              { "$ref": "#/$defs/ragMetrics" },
              { "type": "null" }
            ]
          },
          "humanReview": {
            "type": "object",
            "additionalProperties": false,
            "required": ["citationCorrect", "evidenceSufficient", "notes"],
            "properties": {
              "citationCorrect": { "type": ["boolean", "null"] },
              "evidenceSufficient": { "type": ["boolean", "null"] },
              "notes": { "type": "string" }
            }
          }
        },
        "allOf": [{
          "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
          "then": { "required": ["sources"] }
        }]
      }
    }
  },
  "$defs": {
    "persistedSource": {
      "type": "object",
      "required": ["chunkId", "cited"],
      "properties": {
        "chunkId": { "type": "string", "format": "uuid" },
        "documentId": { "type": "string", "format": "uuid" },
        "versionId": { "type": "string", "format": "uuid" },
        "number": { "type": "integer", "minimum": 1 },
        "cited": { "type": "boolean" },
        "locator": { "type": "object" },
        "snapshot": { "type": "object" }
      }
    },
    "embeddingConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "dimensions"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 }
      }
    },
    "configSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "retrieval", "rerank", "answer", "chat", "embedding", "index", "prompt"],
      "properties": {
        "schemaVersion": { "const": "f24-v1" },
        "mode": { "const": "RAG" },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "topK", "candidateMultiplier", "rrfK", "maxKeywords"],
          "properties": {
            "strategy": { "enum": ["VECTOR", "FUSION"] },
            "topK": { "type": "integer", "minimum": 1 },
            "candidateMultiplier": { "type": "integer", "minimum": 1 },
            "rrfK": { "type": "integer", "minimum": 1 },
            "maxKeywords": { "type": "integer", "minimum": 1 },
            "queryRewrite": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "version", "maxCharacters"],
              "properties": {
                "enabled": { "type": "boolean" },
                "version": { "type": "string", "minLength": 1 },
                "maxCharacters": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "rerank": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "enabled", "provider", "model", "candidateMultiplier", "maxCandidates", "maxEstimatedItemTokens", "maxEstimatedRequestTokens", "timeoutMs", "instruction"],
          "properties": {
            "role": { "const": "RERANK" },
            "enabled": { "type": "boolean" },
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "candidateMultiplier": { "type": "integer", "minimum": 1 },
            "maxCandidates": { "type": "integer", "minimum": 1 },
            "maxEstimatedItemTokens": { "type": "integer", "minimum": 1 },
            "maxEstimatedRequestTokens": { "type": "integer", "minimum": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "instruction": { "type": "string", "minLength": 1 }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxEvidenceTokens", "minimumScores"],
          "properties": {
            "maxEvidenceTokens": { "type": "integer", "minimum": 1 },
            "minimumScores": {
              "type": "object",
              "additionalProperties": false,
              "required": ["vector", "fusion", "rerank"],
              "properties": {
                "vector": { "type": "number", "minimum": -1, "maximum": 1 },
                "fusion": { "type": "number", "minimum": 0, "maximum": 1 },
                "rerank": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "provider", "model", "temperature"],
          "properties": {
            "role": { "const": "CHAT" },
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "temperature": { "type": ["number", "null"] },
            "numCtx": { "type": ["integer", "null"], "minimum": 1 },
            "think": { "type": ["boolean", "null"] }
          },
          "allOf": [{
            "if": { "properties": { "provider": { "not": { "const": "ollama" } } }, "required": ["provider"] },
            "then": { "properties": { "numCtx": { "type": "null" }, "think": { "type": "null" } } }
          }]
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "provider", "model", "dimensions"],
          "properties": {
            "role": { "const": "EMBEDDING" },
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "dimensions": { "type": "integer", "minimum": 1 }
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configHash", "parser", "chunker", "embedding"],
          "properties": {
            "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "parser": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": { "version": { "type": "string", "minLength": 1 } }
            },
            "chunker": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "tokenizer", "maxTokens", "maxChunks"],
              "properties": {
                "version": { "type": "string", "minLength": 1 },
                "tokenizer": { "type": "string", "minLength": 1 },
                "maxTokens": { "type": "integer", "minimum": 1 },
                "maxChunks": { "type": "integer", "minimum": 1 }
              }
            },
            "embedding": { "$ref": "#/$defs/embeddingConfiguration" }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "historyInjection": { "const": "business-prompt-once" },
            "historyMaxRounds": { "type": "integer", "minimum": 1 },
            "historyMaxCharacters": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "chatUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptTokens", "completionTokens", "totalTokens"],
      "properties": {
        "promptTokens": { "type": ["integer", "null"], "minimum": 0 },
        "completionTokens": { "type": ["integer", "null"], "minimum": 0 },
        "totalTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "ragMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceCount", "retrievedEvidenceCount", "scoreFilteredEvidenceCount", "budgetFilteredEvidenceCount", "evidenceTokenCount", "citedCount", "noEvidence", "retrievalMs", "embeddingTotalTokens", "rerankStatus", "rerankCandidateCount", "rerankMs", "rerankTotalTokens", "generationMs", "totalMs", "firstDeltaMs"],
      "properties": {
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "retrievedEvidenceCount": { "type": "integer", "minimum": 0 },
        "scoreFilteredEvidenceCount": { "type": "integer", "minimum": 0 },
        "budgetFilteredEvidenceCount": { "type": "integer", "minimum": 0 },
        "evidenceTokenCount": { "type": "integer", "minimum": 0 },
        "citedCount": { "type": "integer", "minimum": 0 },
        "noEvidence": { "type": "boolean" },
        "retrievalMs": { "type": "integer", "minimum": 0 },
        "embeddingTotalTokens": { "type": ["integer", "null"], "minimum": 0 },
        "rerankStatus": { "enum": ["NOT_REACHED", "DISABLED", "SKIPPED_NO_CANDIDATES", "SKIPPED_INSUFFICIENT_CANDIDATES", "SKIPPED_INPUT_LIMIT", "APPLIED", "FALLBACK_UNAVAILABLE", "FALLBACK_INVALID_RESPONSE"] },
        "rerankCandidateCount": { "type": "integer", "minimum": 0 },
        "rerankMs": { "type": "integer", "minimum": 0 },
        "rerankTotalTokens": { "type": ["integer", "null"], "minimum": 0 },
        "generationMs": { "type": ["integer", "null"], "minimum": 0 },
        "totalMs": { "type": "integer", "minimum": 0 },
        "firstDeltaMs": { "type": ["integer", "null"], "minimum": 0 },
        "queryRewrite": {
          "anyOf": [{ "type": "null" }, {
            "type": "object",
            "additionalProperties": false,
            "required": ["originalQuestion", "retrievalQuestion", "status"],
            "properties": {
              "originalQuestion": { "type": ["string", "null"] },
              "retrievalQuestion": { "type": ["string", "null"] },
              "status": { "enum": ["NOT_ATTEMPTED", "NO_HISTORY", "SELF_CONTAINED", "REWRITTEN", "UNCHANGED", "FALLBACK"] }
            }
          }]
        }
      }
    }
  }
}
